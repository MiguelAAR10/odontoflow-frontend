{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.tsx",
    "src/api.ts",
    "src/voice.ts",
    "src/mockData.ts",
    "src/types.ts",
    "src/contracts/**/*.ts",
    "test/agenda-adapter.test.ts",
    "test/agenda-integration.test.ts",
    "test/patients-adapter.test.ts",
    "test/patients-integration.test.ts",
    "test/cash-adapter.test.ts",
    "test/cash-transport.test.ts",
    "test/inventory-adapter.test.ts",
    "test/voice-adapter.test.ts",
    "test/home-registry.test.ts",
    "test/home-adapter.test.ts",
    "test/home-schedule.test.ts",
    "test/bff-proxy.test.ts",
    "test/bff-secret-guard.test.ts",
    "test/setup-e2e-auth.ts",
    "test/approvals-adapter.test.ts",
    "test/approvals-mock.test.ts",
    "test/bff-persona.test.ts",
    "test/bff-session.test.ts",
    "test/bff-guard.test.ts",
    "test/activity-adapter.test.ts",
    "test/activity-mock.test.ts",
    "vitest.config.ts",
    "next.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
