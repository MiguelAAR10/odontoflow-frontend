    "Card": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "level": {
            "enum": [
              "aprobar",
              "borrador"
            ]
          }
        },
        "required": [
          "level"
        ]
      },
      "properties": {
        "agent": {
          "enum": [
            "airi",
            "cepillo",
            "pasta",
            "hilo",
            "enjuague",
            "espejo",
            "escudo"
          ],
          "title": "Agent",
          "type": "string"
        },
        "alt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        },
        "amounts": {
          "items": {
            "$ref": "#/$defs/LabeledMoney"
          },
          "title": "Amounts",
          "type": "array"
        },
        "approve": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
