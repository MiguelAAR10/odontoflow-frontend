        "edit": {
          "default": false,
          "title": "Edit",
          "type": "boolean"
        },
        "ev": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ev"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "auto",
            "borrador",
            "aprobar"
          ],
          "title": "Level",
          "type": "string"
        },
        "payload_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Hash"
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "result": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "reversible": {
          "default": "unspecified",
          "enum": [
            "none",
            "reversible",
            "reassign",
            "until_patient_accepts",
            "authorized_reversal",
            "window",
            "unspecified"
          ],
          "title": "Reversible",
          "type": "string"
        },
        "scope": {
          "items": {
            "$ref": "#/$defs/CardScope"
          },
          "title": "Scope",
          "type": "array"
        },
        "srcs": {
