            "minLength": 1,
            "type": "string"
          },
          "title": "Srcs",
          "type": "array"
        },
        "state": {
          "enum": [
            "ready",
            "pending",
            "approved",
            "declined",
            "delegated",
            "undone"
          ],
          "title": "State",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "undo": {
          "default": false,
          "title": "Undo",
          "type": "boolean"
        },
        "undo_window_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undo Window Seconds"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        }
      },
      "required": [
        "id",
        "agent",
        "level",
        "state",
        "title",
        "body",
        "version"
      ],
      "then": {
        "properties": {
          "payload_hash": {
            "type": "string"
          }
        },
        "required": [
          "payload_hash"
        ]
      },
