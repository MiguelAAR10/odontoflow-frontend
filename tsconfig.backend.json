{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/server.ts",
    "src/ui.ts",
    "src/index.ts",
    "src/domain/**/*.ts",
    "src/simulation/**/*.ts",
    "test/**/*.ts"
  ]
}
