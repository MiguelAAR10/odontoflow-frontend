{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/server.ts",
    "src/ui.ts",
    "src/index.ts",
    "src/domain/**/*.ts",
    "src/simulation/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "src/domain/odontoRepository.ts",
    "test/odonto-repository.test.ts",
    "test/agenda-adapter.test.ts",
    "test/agenda-integration.test.ts",
    "test/patients-adapter.test.ts",
    "test/patients-integration.test.ts",
    "test/cash-adapter.test.ts",
    "test/cash-transport.test.ts",
    "test/inventory-adapter.test.ts",
    "test/voice-draft.test.ts",
    "test/pilot-e2e.test.ts",
    "test/voice-adapter.test.ts"
  ]
}
