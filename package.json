{
  "name": "odontoflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.backend.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "test": "vitest run",
    "test:visual": "node scripts/visual-check.mjs",
    "start": "node dist/src/server.js",
    "openapi:generate": "openapi-typescript ../odontoflow-backend/docs/api/openapi.yaml -o src/contracts/api.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:pilot": "bash scripts/pilot-e2e.sh"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.50.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
