{
  "name": "odontoflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 5173 -H 127.0.0.1",
    "build": "next build --webpack && tsc -p tsconfig.backend.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "test": "vitest run",
    "e2e:journeys": "python3 e2e/journeys.py",
    "test:visual": "node scripts/visual-check.mjs",
    "start": "next start -p 5173 -H 127.0.0.1",
    "start:legacy": "node dist/src/server.js",
    "openapi:generate": "openapi-typescript ${OPENAPI_SPEC:-docs/api/openapi.yaml} -o src/contracts/api.ts",
    "openapi:check": "node scripts/openapi-check.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:pilot": "bash scripts/pilot-e2e.sh"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@excalidraw/excalidraw": "0.18.1",
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "motion": "13.4.5",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "18.3.1",
    "autoprefixer": "^10.4.21",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.50.1",
    "postcss": "^8.5.3",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
