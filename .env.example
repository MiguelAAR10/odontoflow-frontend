# Frontend (Next.js App Router) — real backend mode
# The frontend calls the real FastAPI backend when NEXT_PUBLIC_USE_MOCKS=false.
# The browser only talks to its own origin (/api/backend/*); the Next server
# (app/api/backend/[...path]/route.ts) forwards to the backend and injects the
# chosen staff persona's credential. The variables below are SERVER-ONLY
# (never NEXT_PUBLIC_).
BACKEND_URL=http://127.0.0.1:8010
# Revocable integration bearer (backend: scripts/issue_credential.py). Used ONLY
# for integration-only routes (/public/*); never as an anonymous fallback.
BACKEND_DEMO_TOKEN=
# Seed JSON [{role, display_name, token}] with one human credential per persona.
BACKEND_DEMO_HUMANS=
# Access code required to choose a persona (POST /api/session). If empty,
# choosing a persona only works on localhost / 127.0.0.1 / [::1]; any other
# host answers 503. Set it on every shared or deployed server.
BFF_ACCESS_CODE=
# HMAC-SHA256 secret that signs the persona cookie (use >= 32 random bytes).
# If empty, a random per-process secret is used and cookies die on restart.
BFF_SESSION_SECRET=
NEXT_PUBLIC_USE_MOCKS=true

# NEXT_PUBLIC_BACKEND_URL is no longer used by the browser. It is only a
# direct-connection override for the Node integration suite
# (npm run test:e2e), which also reads BACKEND_DEMO_TOKEN from its own process
# env. It is not a secret; do not set it for `next dev`/`next build`.
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8010

# Voice assistant (odontoflow-voice) — OPT-IN, off by default.
# With NEXT_PUBLIC_ENABLE_VOICE=false /asistente redirects to /agenda and the nav
# item is hidden; the route is not exposed to users.
#
# The gate is AND, not OR:
#   NEXT_PUBLIC_ENABLE_VOICE=false                        -> no route, no HTTP, ever
#   NEXT_PUBLIC_ENABLE_VOICE=true  + NEXT_PUBLIC_USE_MOCKS=true  -> page renders, NO HTTP ever
#   NEXT_PUBLIC_ENABLE_VOICE=true  + NEXT_PUBLIC_USE_MOCKS=false -> live, uses NEXT_PUBLIC_VOICE_URL
#
# 8000 is the port odontoflow-voice documents (uvicorn app.main:app --port 8000);
# it does not collide with the backend's 8010.
NEXT_PUBLIC_ENABLE_VOICE=false
NEXT_PUBLIC_VOICE_URL=http://127.0.0.1:8000

# Legacy simulator (reference only — src/domain, src/simulation, src/server.ts).
# Used only when running the old follow-up harness; not part of the real SPA.
DATABASE_URL=postgresql://simulator:simulator@localhost:5432/odonto_simulator
SIMULATION_TIME_ZONE=America/Lima
