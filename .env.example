# Frontend (Next.js App Router) — real backend mode
# The frontend calls the real FastAPI backend when NEXT_PUBLIC_USE_MOCKS=false.
# Default base URL matches the E2E harness (scripts/pilot-e2e.sh boots on :8010).
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8010
NEXT_PUBLIC_USE_MOCKS=true

# Voice assistant (odontoflow-voice) — OPT-IN, off by default.
# With NEXT_PUBLIC_ENABLE_VOICE=false /asistente redirects to /agenda and the nav
# item is hidden; the route is not exposed to users.
#
# The gate is AND, not OR:
#   NEXT_PUBLIC_ENABLE_VOICE=false                        -> no route, no HTTP, ever
#   NEXT_PUBLIC_ENABLE_VOICE=true  + NEXT_PUBLIC_USE_MOCKS=true  -> page renders, NO HTTP ever
#   NEXT_PUBLIC_ENABLE_VOICE=true  + NEXT_PUBLIC_USE_MOCKS=false -> live, uses NEXT_PUBLIC_VOICE_URL
#
# 8000 is the port odontoflow-voice documents (uvicorn app.main:app --port 8000);
# it does not collide with the backend's 8010.
NEXT_PUBLIC_ENABLE_VOICE=false
NEXT_PUBLIC_VOICE_URL=http://127.0.0.1:8000

# Legacy simulator (reference only — src/domain, src/simulation, src/server.ts).
# Used only when running the old follow-up harness; not part of the real SPA.
DATABASE_URL=postgresql://simulator:simulator@localhost:5432/odonto_simulator
SIMULATION_TIME_ZONE=America/Lima
